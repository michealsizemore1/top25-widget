<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".run.RunsActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher_run"
            android:roundIcon="@drawable/ic_launcher_run"
            android:label="Running"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.michealsizemore1.top25widget.running">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Strava sends you back here after you approve the connection. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="scoresrun" android:host="localhost" />
            </intent-filter>
        </activity>
        <activity
            android:name=".run.RunDetailActivity"
            android:exported="false"
            android:label="Run"
            android:taskAffinity="io.github.michealsizemore1.top25widget.running" />
        <activity
            android:name=".run.RunSettingsActivity"
            android:exported="false"
            android:label="Run settings"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity="io.github.michealsizemore1.top25widget.running" />
        <service
            android:name=".run.RunReceiverService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/run/" />
            </intent-filter>
        </service>

        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:label="Game"
            android:launchMode="singleTop"
            android:taskAffinity=".game"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <receiver
            android:name=".ScoresWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scores_widget_info" />
        </receiver>
        <receiver
            android:name=".NflScoresWidgetReceiver"
            android:exported="true"
            android:label="@string/nfl_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nfl_widget_info" />
        </receiver>
        <receiver
            android:name=".WnbaScoresWidgetReceiver"
            android:exported="true"
            android:label="@string/wnba_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wnba_widget_info" />
        </receiver>
        <receiver
            android:name=".NhlScoresWidgetReceiver"
            android:exported="true"
            android:label="@string/nhl_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nhl_widget_info" />
        </receiver>
        <receiver
            android:name=".XcWidgetReceiver"
            android:exported="true"
            android:label="@string/xc_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/xc_widget_info" />
        </receiver>
        <receiver
            android:name=".TfWidgetReceiver"
            android:exported="true"
            android:label="@string/tf_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tf_widget_info" />
        </receiver>
    </application>
</manifest>
